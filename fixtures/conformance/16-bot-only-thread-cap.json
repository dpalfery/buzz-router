{
  "case": 16,
  "requirement": "13.3",
  "title": "Bot-only thread: A and B alternate @-mentions until both have used 4 turns",
  "roster": {"owner": "O", "bots": ["A", "B", "C"], "respond_to": {}, "default_bot": null},
  "local_bots": ["A", "B", "C"],
  "members": ["A", "B", "C"],
  "now": "2026-10-05T15:00:00Z",
  "quiet": [],
  "halts": {"all": false, "bots": []},
  "wake_counts": {},
  "steps": [
    {"event": {"label": "a1", "author": "A", "kind": 9, "content": "@B can you look at this?"},
     "expect": {"decisions": [{"wake": {"bot": "B", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"create": {"root": "a1"}, "add_participants": ["A", "B"], "new_round": {"round_id": "a1", "mode": "direct"}},
                "wake_mode": "direct"}},
    {"event": {"label": "b1", "author": "B", "kind": 9, "content": "@A done, over to you",
               "reply": {"root": "a1", "parent": "a1"}},
     "expect": {"decisions": [{"wake": {"bot": "A", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "a2", "author": "A", "kind": 9, "content": "@B one more question",
               "reply": {"root": "a1", "parent": "b1"}},
     "expect": {"decisions": [{"wake": {"bot": "B", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "b2", "author": "B", "kind": 9, "content": "@A answered",
               "reply": {"root": "a1", "parent": "a2"}},
     "expect": {"decisions": [{"wake": {"bot": "A", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "a3", "author": "A", "kind": 9, "content": "@B and a third thing",
               "reply": {"root": "a1", "parent": "b2"}},
     "expect": {"decisions": [{"wake": {"bot": "B", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "b3", "author": "B", "kind": 9, "content": "@A done again",
               "reply": {"root": "a1", "parent": "a3"}},
     "expect": {"decisions": [{"wake": {"bot": "A", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "a4", "author": "A", "kind": 9, "content": "@B last question for now",
               "reply": {"root": "a1", "parent": "b3"}},
     "expect": {"decisions": [{"wake": {"bot": "B", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "b4", "author": "B", "kind": 9, "content": "@A answered that too",
               "reply": {"root": "a1", "parent": "a4"}},
     "expect": {"decisions": [{"wake": {"bot": "A", "reason": "bot_mention", "priority": "bot", "debounce": true}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "a5", "author": "A", "kind": 9, "content": "@B one more please",
               "reply": {"root": "a1", "parent": "b4"}},
     "expect": {"decisions": [{"suppress": {"bot": "B", "why": "cap"}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}},
    {"event": {"label": "b5", "author": "B", "kind": 9, "content": "@A here is the answer",
               "reply": {"root": "a1", "parent": "a5"}},
     "expect": {"decisions": [{"suppress": {"bot": "A", "why": "cap"}}],
                "thread_update": {"add_participants": ["A", "B"]},
                "wake_mode": "direct"}}
  ]
}
